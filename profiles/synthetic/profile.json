{
  "schema": 1,
  "profile": {
    "version": "1.0.0",
    "license": "CC0-1.0",
    "authors": ["AMUN contributors"],
    "provenance": "Fully synthetic values for host and hardware self-testing; no commercial-game addresses.",
    "integrity": "developer"
  },
  "game": {
    "platform": "3ds",
    "titleId": "000400000FF40A00",
    "name": "AMUN Synthetic Adventure",
    "builds": [
      {
        "id": "synthetic-eur-v1",
        "region": "EUR",
        "applicationVersion": "1.0.0",
        "updateVersion": "0",
        "codeFingerprint": "live-text-crc32-v1:00123000:89ABCDEF",
        "compatible": false
      }
    ]
  },
  "symbols": {
    "battle.id": {
      "type": "u8",
      "poll": "normal",
      "resolver": {"kind": "module_relative", "offset": "0x00002000"}
    },
    "boss.hp": {
      "type": "s32",
      "poll": "fast",
      "resolver": {"kind": "absolute", "address": "0x08001010"}
    },
    "challenge.healed": {
      "type": "u8",
      "poll": "fast",
      "resolver": {"kind": "absolute", "address": "0x08001020"}
    },
    "collectibles.count": {
      "type": "u16",
      "poll": "normal",
      "resolver": {"kind": "absolute", "address": "0x08001030"}
    },
    "inventory.key_count": {
      "type": "u16",
      "poll": "slow",
      "resolver": {
        "kind": "pointer_chain",
        "address": "0x08002000",
        "offsets": [0, 32, 8]
      }
    },
    "player.hp": {
      "type": "u16",
      "poll": "fast",
      "resolver": {"kind": "absolute", "address": "0x08001000"}
    },
    "player.hp_percent": {
      "type": "u32",
      "poll": "normal",
      "resolver": {
        "kind": "derived",
        "expression": {
          "op": "divide",
          "left": {
            "op": "multiply",
            "left": {"symbol": "player.hp"},
            "right": 100
          },
          "right": {"symbol": "player.max_hp"}
        }
      }
    },
    "player.max_hp": {
      "type": "u16",
      "poll": "static",
      "resolver": {"kind": "absolute", "address": "0x08001002"}
    },
    "session.paused": {
      "type": "bool",
      "poll": "fast",
      "resolver": {"kind": "absolute", "address": "0x08001024"}
    },
    "state.name": {
      "type": "fixed_string",
      "size": 8,
      "poll": "slow",
      "resolver": {"kind": "absolute", "address": "0x08001040"}
    },
    "world.flags": {
      "type": "u32",
      "poll": "normal",
      "resolver": {
        "kind": "pattern",
        "scanStart": "0x00100000",
        "scanSize": "0x00040000",
        "resultOffset": 12,
        "pattern": "E3 A0 ?? ?? E5 9F 00 04"
      }
    }
  },
  "assets": {
    "icon.boss": {
      "kind": "icon",
      "format": "rgb565",
      "compression": "byte_rle",
      "width": 2,
      "height": 2,
      "data": "00 F8 00 F8 E0 07 E0 07"
    }
  },
  "achievements": [
